# Environment
ENVIRONMENT=development

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
DB_NAME=personal_life_os

# Google Gemini API (Get free key from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail IMAP Credentials (16-character App Password from Google Account Security)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
POLL_INTERVAL_SECONDS=300